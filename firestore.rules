rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 누구나 읽기 가능, days/terra/rounds는 누구나 쓰기 가능
    match /days/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /terra/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /rounds/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Elo 레이팅 — 누구나 읽기, 인증된 사용자 쓰기
    match /club/ratings {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 회원/설정/이벤트는 관리자(로그인)만 쓰기 가능
    match /club/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "mk5minki@gmail.com";
    }
    // 회원 본인의 생년월일/테니스시작년월 자기 수정 허용
    // (list 필드만, 크기 불변 — 멤버 추가/삭제 불가)
    match /club/members {
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list.size() == resource.data.list.size();
    }
    match /events/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 일정 공유 - 누구나 읽고 쓰기 가능
    match /schedules/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // 회원가입 신청 - 본인 신청만 생성 가능, 승인/거절은 관리자만
    match /signupRequests/{reqId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.token.email == "mk5minki@gmail.com";
    }

    // 점수 제안 - 방문자는 로그인 없이도 제한된 형식의 제안만 생성할 수 있고,
    // 확정·수정·삭제는 관리자만 가능
    match /scoreSubmissions/{submissionId} {
      allow create: if request.resource.data.keys().hasAll([
          'type', 'dayId', 'rIdx', 'matchId', 'team1', 'team2', 'positions',
          'score1', 'score2', 'status', 'submittedBy', 'submitterUid', 'submittedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'type', 'dayId', 'rIdx', 'matchId', 'team1', 'team2', 'positions',
          'score1', 'score2', 'status', 'submittedBy', 'submitterUid', 'submittedAt'
        ])
        && request.resource.data.type == 'seasonMatch'
        && request.resource.data.status == 'pending'
        && request.resource.data.score1 is int && request.resource.data.score1 >= 0 && request.resource.data.score1 <= 99
        && request.resource.data.score2 is int && request.resource.data.score2 >= 0 && request.resource.data.score2 <= 99
        && request.resource.data.dayId is string
        && request.resource.data.matchId is string
        && request.resource.data.rIdx is int
        && request.resource.data.submittedBy is string
        && request.resource.data.submitterUid is string;
      allow read, update, delete: if request.auth != null && request.auth.token.email == "mk5minki@gmail.com";
    }

    // 즉석매치 요청 - 정회원 UI에서 요청만 생성하고, 경기표 반영은 관리자만 처리
    match /matchRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.dayId is string
        && request.resource.data.rIdx is int;
      allow read, update, delete: if request.auth != null && request.auth.token.email == "mk5minki@gmail.com";
    }

    // 게시판 - 누구나 읽고 쓰기 가능
    match /boardPosts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    // 공지사항 - 누구나 읽기 가능, 관리자만 쓰기 가능
    match /announcements/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "mk5minki@gmail.com";
    }

  }
}
